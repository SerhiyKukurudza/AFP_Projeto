void Eliminar_aeronaves(TipoAeronave aero[])
{
    int n;
    printf("\nIndique o index da Aeronave no array:");
    scanf("%d", &n);


    aero[n].id=0;
    aero[n].capacidade= 0;
    aero[n].estado='\0';
    aero[n].local[0]='\0';
    aero[n].destino[0]='\0';
    aero[n].numVoos= 0;
}



